rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'acer86380@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId);
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only server-side Firebase Admin SDK can grant admin roles
    }

    // Contests metadata (Public read for active/published, admin write)
    match /contests/{contestId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Problems (Public read of statements; hidden test cases are never stored here)
    match /problems/{problemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Participants
    match /participants/{participantId} {
      // Leaderboard reads allow viewing public participant scores
      allow read: if isSignedIn();
      // Participants can register or update basic activity, but cannot modify totalScore, solvedCount, or problemScores
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.totalScore == 0 &&
        request.resource.data.solvedCount == 0
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        // Protect scoring fields from tampering
        request.resource.data.totalScore == resource.data.totalScore &&
        request.resource.data.solvedCount == resource.data.solvedCount &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin();
    }

    // Submissions
    match /submissions/{submissionId} {
      // Participants can ONLY read their own submissions; Admins can read all
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.participantId == request.auth.uid ||
          resource.data.participantId == 'participant-' + request.auth.uid
        )
      );
      // Submissions can only be scored and finalized via server API functions
      allow create: if isSignedIn() && (
        request.resource.data.participantId == request.auth.uid ||
        request.resource.data.participantId == 'participant-' + request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Integrity Telemetry Events
    match /integrityEvents/{eventId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.participantId == request.auth.uid ||
          resource.data.participantId == 'participant-' + request.auth.uid
        )
      );
      allow create: if isSignedIn() && (
        request.resource.data.participantId == request.auth.uid ||
        request.resource.data.participantId == 'participant-' + request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Participant Drafts
    match /drafts/{draftId} {
      allow read, write: if isSignedIn();
    }
  }
}
